diff --git a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/awdl_events.c b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/awdl_events.c
new file mode 100644
--- /dev/null
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/awdl_events.c
@@ -0,0 +1,117 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * AWDL firmware-event forwarding for brcmfmac (BCM4378).
+ *
+ * Apple's Broadcom firmware runs the AWDL (Apple Wireless Direct Link) engine
+ * in the dongle: availability-window timing, TSF sync, channel hopping, the
+ * master-election tree and the transmission/reception of the PSF and MIF
+ * action frames. brcmfmac never forwards the AWDL-related firmware events to
+ * userspace, so a listener cannot see what the firmware has received or how
+ * the election is converging.
+ *
+ * This file forwards those events - the AWDL_* firmware events and the
+ * ACTION_FRAME_RX / ACTION_FRAME_COMPLETE events raised on an AWDL interface -
+ * to userspace as nl80211 NL80211_CMD_VENDOR multicast events, so a Python
+ * listener (awdlevents.py) can decode the AW windows, the master/slave role,
+ * and the received PSF/MIF frames (awdlparse.py) into a peer's hostname and
+ * announced services.
+ *
+ * This is a DISCOVERY / control-plane enrichment only. It does not move any
+ * data and does not touch the (confirmed non-functional) AWDL data path.
+ *
+ * Derived from the AWDL event-forwarding work in
+ *   andreanicassio/brcmfmac-awdl  (awdl.c, brcmf_awdl_notify_fwevent)
+ * which builds on brentkearney/omdrop-awdl. As a derivative of the Linux
+ * kernel's brcmfmac driver this file is GPL-2.0-only, like the code it
+ * derives from.
+ */
+#include <linux/netdevice.h>
+#include <linux/etherdevice.h>
+#include <linux/if_ether.h>
+#include <net/cfg80211.h>
+#include <net/netlink.h>
+
+#include "core.h"
+#include "debug.h"
+#include "fweh.h"
+#include "cfg80211.h"
+#include "vendor.h"
+#include "awdl_events.h"
+
+/* Forward one firmware event (header + raw payload) to userspace as a
+ * BRCMF_VNDR_EVT_FWEVENT nl80211 vendor multicast event. Registered as the
+ * fweh handler for the AWDL_* event codes, and called directly from the
+ * action-frame RX/complete handlers when the interface is awdl0.
+ *
+ * Matches brcmf_fweh_handler_t: returns 0 on success, negative on error.
+ */
+int brcmf_awdl_notify_fwevent(struct brcmf_if *ifp,
+			      const struct brcmf_event_msg *e, void *data)
+{
+	struct brcmf_cfg80211_info *cfg = ifp->drvr->config;
+	struct wiphy *wiphy = cfg_to_wiphy(cfg);
+	struct wireless_dev *wdev = NULL;
+	struct brcmf_vndr_fwevent_hdr hdr;
+	struct sk_buff *skb;
+	u32 datalen = e->datalen;
+
+	if (datalen > BRCMF_DCMD_MAXLEN)
+		datalen = BRCMF_DCMD_MAXLEN;
+
+	/* Attach the event to awdl0's wdev when its netdev is registered, so a
+	 * listener can filter by interface; fall back to a wiphy-wide event.
+	 */
+	if (ifp->vif && ifp->vif->wdev.netdev &&
+	    ifp->vif->wdev.netdev->reg_state == NETREG_REGISTERED)
+		wdev = &ifp->vif->wdev;
+
+	hdr.event_code = cpu_to_le32(e->event_code);
+	hdr.status = cpu_to_le32(e->status);
+	hdr.reason = cpu_to_le32(e->reason);
+	hdr.flags = cpu_to_le32(e->flags);
+	hdr.ifidx = cpu_to_le32(e->ifidx);
+	hdr.bsscfgidx = cpu_to_le32(e->bsscfgidx);
+	memcpy(hdr.addr, e->addr, ETH_ALEN);
+	hdr.datalen = cpu_to_le16(datalen);
+
+	skb = cfg80211_vendor_event_alloc(wiphy, wdev,
+					  sizeof(hdr) + datalen + 32,
+					  BRCMF_VNDR_EVT_FWEVENT, GFP_KERNEL);
+	if (!skb)
+		return -ENOMEM;
+
+	if (nla_put(skb, BRCMF_NLATTR_FWEVENT_HDR, sizeof(hdr), &hdr) ||
+	    (datalen && nla_put(skb, BRCMF_NLATTR_FWEVENT_DATA, datalen, data))) {
+		kfree_skb(skb);
+		return -ENOBUFS;
+	}
+	cfg80211_vendor_event(skb, GFP_KERNEL);
+	brcmf_dbg(EVENT,
+		  "awdl: forwarded fw event %u status %u ifidx %u len %u\n",
+		  e->event_code, e->status, e->ifidx, datalen);
+	return 0;
+}
+
+/* Register brcmf_awdl_notify_fwevent() for every AWDL firmware event code.
+ * fweh drops events whose code has no registered handler, so without this the
+ * AWDL_* events never reach the forwarder. The ACTION_FRAME_RX (75) and
+ * ACTION_FRAME_COMPLETE (60) events already have p2p handlers registered; those
+ * are intercepted for AWDL interfaces inside p2p.c instead.
+ */
+void brcmf_awdl_register_event_handlers(struct brcmf_cfg80211_info *cfg)
+{
+	static const enum brcmf_fweh_event_code codes[] = {
+		BRCMF_E_AWDL_AW, BRCMF_E_AWDL_ROLE, BRCMF_E_AWDL_EVENT,
+		BRCMF_E_AWDL_AW_EXT_END, BRCMF_E_AWDL_AW_EXT_START,
+		BRCMF_E_AWDL_AW_START, BRCMF_E_AWDL_RADIO_OFF,
+		BRCMF_E_AWDL_PEER_STATE, BRCMF_E_AWDL_SYNC_STATE_CHANGED,
+		BRCMF_E_AWDL_CHIP_RESET, BRCMF_E_AWDL_INTERLEAVED_SCAN_START,
+		BRCMF_E_AWDL_INTERLEAVED_SCAN_STOP,
+		BRCMF_E_AWDL_PEER_CACHE_CONTROL,
+	};
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(codes); i++)
+		brcmf_fweh_register(cfg->pub, codes[i],
+				    brcmf_awdl_notify_fwevent);
+}
diff --git a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/awdl_events.h b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/awdl_events.h
new file mode 100644
--- /dev/null
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/awdl_events.h
@@ -0,0 +1,24 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * AWDL firmware-event forwarding for brcmfmac. See awdl_events.c.
+ *
+ * Derived from andreanicassio/brcmfmac-awdl and brentkearney/omdrop-awdl;
+ * GPL-2.0-only as a derivative of the kernel's brcmfmac driver.
+ */
+#ifndef BRCMFMAC_AWDL_EVENTS_H
+#define BRCMFMAC_AWDL_EVENTS_H
+
+struct brcmf_if;
+struct brcmf_event_msg;
+struct brcmf_cfg80211_info;
+
+/* Forward one firmware event (header + raw payload) to userspace as a
+ * BRCMF_VNDR_EVT_FWEVENT nl80211 vendor multicast event.
+ */
+int brcmf_awdl_notify_fwevent(struct brcmf_if *ifp,
+			      const struct brcmf_event_msg *e, void *data);
+
+/* Register brcmf_awdl_notify_fwevent() for the AWDL_* firmware event codes. */
+void brcmf_awdl_register_event_handlers(struct brcmf_cfg80211_info *cfg);
+
+#endif /* BRCMFMAC_AWDL_EVENTS_H */
