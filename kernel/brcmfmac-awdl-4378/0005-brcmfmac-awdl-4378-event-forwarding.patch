@@ -37,6 +37,8 @@
 
 	BRCMF_NLATTR_LEN,
 	BRCMF_NLATTR_DATA,
+	BRCMF_NLATTR_FWEVENT_HDR,	/* struct brcmf_vndr_fwevent_hdr */
+	BRCMF_NLATTR_FWEVENT_DATA,	/* raw firmware event payload */
 
 	__BRCMF_NLATTR_AFTER_LAST,
 	BRCMF_NLATTR_MAX = __BRCMF_NLATTR_AFTER_LAST - 1
@@ -62,4 +64,29 @@
 
 extern const struct wiphy_vendor_command brcmf_vendor_cmds[];
 
+/* AWDL firmware-event forwarding: nl80211 NL80211_CMD_VENDOR multicast events */
+enum brcmf_vndr_evts {
+	BRCMF_VNDR_EVT_FWEVENT,		/* raw firmware event (AWDL etc.) */
+	BRCMF_VNDR_EVT_LAST
+};
+
+/**
+ * struct brcmf_vndr_fwevent_hdr - header carried in BRCMF_NLATTR_FWEVENT_HDR
+ *
+ * Little-endian on the wire. Followed by BRCMF_NLATTR_FWEVENT_DATA (the raw
+ * firmware event payload, @datalen bytes).
+ */
+struct brcmf_vndr_fwevent_hdr {
+	__le32 event_code;
+	__le32 status;
+	__le32 reason;
+	__le32 flags;
+	__le32 ifidx;
+	__le32 bsscfgidx;
+	u8 addr[6];
+	__le16 datalen;
+} __packed;
+
+extern const struct nl80211_vendor_cmd_info brcmf_vendor_events[];
+
 #endif /* _vendor_h_ */
