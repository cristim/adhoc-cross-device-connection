[Unit]
Description=Adhoc Cross-Device Connection Airdrop-compatible receiver (10-minute Everyone window)

[Service]
Type=exec
Environment=PATH=/usr/bin:/bin
ExecStart=/usr/bin/ac-dc receive --directory %h/Downloads/Adhoc --tls-identity %h/.local/share/ac-dc/airdrop --name Linux --seconds 600 --notify
UMask=0077
TimeoutStopSec=15
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
